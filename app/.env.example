# Copy this file to app/.env and fill in your own values. Never commit .env.
# ---- database (Neo4j Aura)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ---- web app
# Signs the session cookie. 32+ characters. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string
# development or production. Production: Secure cookies, HSTS, /docs hidden, no demo login chips.
APP_ENV=development
# true to expose /docs, /redoc and /openapi.json in production (default: only in development)
ENABLE_DOCS=
# Optional, comma separated origins allowed for CORS and CSRF (for example https://85-211-182-145.sslip.io)
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
# Show the clickable demo email chips on the login page (default: true in development, false in production)
SHOW_DEMO_LOGINS=

# ---- docker compose / Caddy (read from the shell or a root .env, not by the app)
# SITE_ADDRESS=85-211-182-145.sslip.io
