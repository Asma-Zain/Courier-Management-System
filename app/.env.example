# Copy this file to .env and fill in your own values. Never commit .env.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# Web app (backend/). Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string
# Set to true when served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=false
# Optional, comma separated origins allowed by CORS (empty = same-origin only)
CORS_ORIGINS=
